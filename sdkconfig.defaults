# Beaverbeaver dedicated digital-person build defaults.
# Keep these values here so `idf.py set-target`, fullclean, or a fresh clone
# cannot silently fall back to ESP-IDF's 2 MB / single-app partition layout.
CONFIG_IDF_TARGET="esp32p4"

CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"

# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v1/32m_digital_people.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/v1/32m_digital_people.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000

CONFIG_BOARD_TYPE_METALIO_CLAW_4=y
CONFIG_DIGITAL_PEOPLE_ONLY=y
CONFIG_ALWAYS_ON_SENSOR_CAPTURE=y
CONFIG_ALWAYS_ON_MICROPHONE=y
CONFIG_ALWAYS_ON_CAMERA=y

CONFIG_BACKGROUND_RECORDING=y
CONFIG_BACKGROUND_RECORDING_PHOTO_INTERVAL_MS=5000
CONFIG_BACKGROUND_RECORDING_AUDIO_SEGMENT_MS=30000
CONFIG_BACKGROUND_RECORDING_UPLOAD_URL="http://172.19.0.245:8788/api/v1/media/upload"
CONFIG_BACKGROUND_RECORDING_UPLOAD_TOKEN="dev-token"
CONFIG_BACKGROUND_RECORDING_UPLOAD_TIMEOUT_MS=15000
CONFIG_ESP_CLAW_AGENT=y

# esp-claw master currently calls an esp_http_client pooling API introduced
# after IDF 5.5.4. Keep its optional pool disabled; claw_core still uses the
# normal ESP-IDF HTTP client.
# CONFIG_HTTP_REUSE_ENABLE is not set

CONFIG_CAMERA_OV2710_MIPI_RAW10_1280X720_25FPS=y

# CONFIG_WAKE_WORD_DISABLED is not set
CONFIG_USE_AFE_WAKE_WORD=y
CONFIG_SEND_WAKE_WORD_DATA=y
CONFIG_USE_AUDIO_PROCESSOR=y
